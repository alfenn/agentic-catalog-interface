$-- Pandoc LaTeX template reproducing iclr_template.tex (ICLR 2025 style, final copy).
$-- report.md supplies the title, author, running header, and body; build_report.py
$-- renders it with --natbib. Keep this frame in sync with iclr_template.tex.
\documentclass{article}
\PassOptionsToPackage{hyphens}{url}
\usepackage{iclr2025_conference,times}
\usepackage{hyperref}
\usepackage{xurl}

\usepackage{xcolor}
\hypersetup{colorlinks=true, linkcolor=black, citecolor=black,
  urlcolor={blue!70!black},
  pdftitle={$pdftitle$},
  pdfauthor={$for(author)$$author$$sep$, $endfor$}}

% Additions pandoc output needs (tables, figures, tight lists).
\usepackage{longtable,booktabs,array,calc}
\usepackage{etoolbox}
\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother
\usepackage{graphicx}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}%
  \else\usebox{\pandoc@box}%
  \fi%
}
\def\fps@figure{htbp}
\makeatother
\providecommand{\tightlist}{%
  \setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\newcounter{none}
\setlength{\LTcapwidth}{\textwidth}
$for(header-includes)$
$header-includes$
$endfor$

$if(comment)$
% $comment$
$endif$

\title{$title$}
\author{$for(author)$$author$$sep$ \And $endfor$}
\iclrfinalcopy

\begin{document}
\maketitle
\vspace{-0.3in}
\lhead{$running-header$}

$body$

\label{reportlastpage}
\end{document}
