# Copy to .env and fill in secrets. Never commit .env.
OPENROUTER_API_KEY=

# Agent model and inference controls.
CATALOG_STEWARD_MODEL=openai/gpt-6-luna
CATALOG_STEWARD_REASONING_EFFORT=low
CATALOG_STEWARD_BUDGET_USD=10

# Evaluation bounds. Leave EVAL_SLICE empty to use the full selected suite.
CATALOG_STEWARD_EVAL_SLICE=
CATALOG_STEWARD_EVAL_CONCURRENCY=2

# Local runtime paths, relative to the repository root unless absolute.
CATALOG_STEWARD_CACHE_DIR=.lm_cache
CATALOG_STEWARD_RESULTS_DIR=experiments/results
CATALOG_STEWARD_DBT_PROJECT_DIR=data/fixtures/dbt_catalog
CATALOG_STEWARD_WAREHOUSE_PATH=.artifacts/catalog.duckdb

